# Скопируйте в config/odoo.conf и заполните своими значениями:
#   cp config/odoo.conf.example config/odoo.conf
#
# Обратите внимание: файл содержит пароли, поэтому он в .gitignore.
[options]
addons_path = /mnt/extra-addons
data_dir = /var/lib/odoo
http_interface = 0.0.0.0
; Мастер-пароль для управления базами данных (создание/удаление/дампы)
admin_passwd = change-me-master-password

; --- подключение к PostgreSQL ---
db_host = db
db_port = 5432
db_user = odoo
db_password = change-me-strong-password
db_maxconn = 64

; --- ресурсы (машина с 8 ГБ RAM) ---
workers = 0
max_cron_threads = 2
limit_memory_hard = 2684354560
limit_memory_soft = 2147483648
limit_request = 8192
limit_time_cpu = 60
limit_time_real = 120

; --- прочее ---
dbfilter = .*
list_db = True
log_level = info
